  "querify": { "actions": ["generate"], "boundary": "at least one file generates successfully" },
  "compare-config": { "actions": ["unified_*"], "boundary": "comparison completes and results render" },
  "run-query": { "actions": ["run"], "boundary": "Jenkins reports the run complete" },
  "run-batch": { "actions": ["run"], "boundary": "Jenkins reports the batch run complete" },
  "html-template": { "actions": ["format", "minify", "copy"], "boundary": "transformation or clipboard write succeeds" },
