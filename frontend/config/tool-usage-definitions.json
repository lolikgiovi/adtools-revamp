  "check-image": { "actions": ["check"], "boundary": "the requested image-check batch completes" },
  "master-lockey": { "actions": ["bulk_search", "bulk_search_copy", "bulk_search_copy_lockey", "bulk_confluence_search", "bulk_confluence_copy_lockey", "bulk_confluence_copy_table", "confluence_copy_lockey", "confluence_copy_table"], "boundary": "search returns results or clipboard write succeeds" }
