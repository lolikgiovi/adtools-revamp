{
  "version": 2,
  "categories": [
    {
      "id": "app-settings",
      "label": "App Settings",
      "initiallyExpanded": true,
      "items": [
        {
          "key": "theme",
          "storageKey": "theme",
          "label": "Theme",
          "type": "enum",
          "default": "system",
          "options": [
            {
              "value": "light",
              "label": "[Light] Quiet Light"
            },
            {
              "value": "grey-muted",
              "label": "[Light] Solarized Light"
            },
            {
              "value": "grey-paper",
              "label": "[Light] Sepia"
            },
            {
              "value": "soft-pink",
              "label": "[Light] Light Pink"
            },
            {
              "value": "ocean-blue",
              "label": "[Light] Winter is Coming"
            },
            {
              "value": "luxury-green",
              "label": "[Light] Everforest"
            },
            {
              "value": "catppuccin-latte",
              "label": "[Light] Catppuccin Latte"
            },
            {
              "value": "atom-one-light",
              "label": "[Light] Atom One Light"
            },
            {
              "value": "nord-light",
              "label": "[Light] Nord Light"
            },
            {
              "value": "dark-grey",
              "label": "[Dark] One Dark Pro"
            },
            {
              "value": "dark",
              "label": "[Dark] Tokyo Night"
            },
            {
              "value": "dracula",
              "label": "[Dark] Dracula"
            },
            {
              "value": "catppuccin-mocha",
              "label": "[Dark] Catppuccin Mocha"
            },
            {
              "value": "nord",
              "label": "[Dark] Nord"
            },
            {
              "value": "gruvbox-dark",
              "label": "[Dark] Gruvbox Dark"
            },
            {
              "value": "monokai-pro",
              "label": "[Dark] Monokai Pro"
            },
            {
              "value": "palenight",
              "label": "[Dark] Palenight"
            },
            {
              "value": "github-dark-hc",
              "label": "[Dark] GitHub Dark High Contrast"
            },
            {
              "value": "cobalt2",
              "label": "[Dark] Cobalt2"
            }
          ],
          "apply": "theme",
          "description": "Choose the color theme for the app."
        },
        {
          "key": "update.autoCheck",
          "storageKey": "update.autoCheck",
          "label": "Check for Auto Update",
          "type": "boolean",
          "default": true,
          "description": "When enabled, the app checks at startup and scheduled times.",
          "requiresTauri": true
        },
        {
          "key": "update.allowBeta",
          "storageKey": "update.allowBeta",
          "label": "Allow Beta Update",
          "type": "boolean",
          "default": false,
          "description": "Opt into beta channel updates (uses manifest/beta.json).",
          "requiresTauri": true
        },
        {
          "key": "update.check",
          "storageKey": "update.check",
          "label": "Check for Update",
          "type": "action",
          "buttonLabel": "Check Now",
          "description": "Manually check for updates and show banner if available.",
          "requiresTauri": true
        }
      ]
    },
    {
      "id": "environments",
      "label": "Testing Environments",
      "initiallyExpanded": true,
      "items": [
        {
          "key": "config.environments",
          "storageKey": "config.environments",
          "label": "Environments",
          "type": "environments",
          "default": [],
          "description": "Each environment pairs a critical database, an optional complementary database, and the CDN public and direct URLs. Tools read this shared model."
        }
      ]
    },
    {
      "id": "app-integration",
      "label": "App Integration",
      "initiallyExpanded": true,
      "categories": [
        {
          "id": "confluence",
          "label": "Confluence",
          "initiallyExpanded": true,
          "items": [
            {
              "key": "config.confluence.domain",
              "storageKey": "config.confluence.domain",
              "label": "Confluence Domain",
              "type": "string",
              "default": "",
              "description": "Base URL (e.g., https://confluence.example.com)",
              "validation": {
                "pattern": "^https?://"
              }
            },
            {
              "key": "config.confluence.username",
              "storageKey": "config.confluence.username",
              "label": "Confluence Username",
              "type": "string",
              "default": "",
              "description": "Username for Confluence authentication",
              "requiresTauri": true
            },
            {
              "key": "secure.confluence.pat",
              "storageKey": "secure.confluence.pat",
              "label": "Confluence PAT",
              "type": "secret",
              "default": "",
              "description": "Personal Access Token. Generate in Confluence: Profile \u2192 Personal Access Tokens \u2192 Create token. Stored in macOS Keychain.",
              "validation": {
                "required": true,
                "minLength": 8
              },
              "requiresTauri": true
            }
          ],
          "integration": true
        },
        {
          "id": "jira",
          "label": "Jira",
          "initiallyExpanded": true,
          "items": [
            {
              "key": "config.jira.url",
              "storageKey": "config.jira.url",
              "label": "Jira URL",
              "type": "string",
              "default": "https://jira.corp.devmandiri.co.id",
              "description": "Jira Data Center base URL used by Ticket Template.",
              "validation": {
                "required": true,
                "pattern": "^https://"
              }
            },
            {
              "key": "config.jira.username",
              "storageKey": "config.jira.username",
              "label": "Jira Username",
              "type": "string",
              "default": "",
              "requiresTauri": true
            },
            {
              "key": "secure.jira.pat",
              "storageKey": "secure.jira.pat",
              "label": "Jira PAT",
              "type": "secret",
              "default": "",
              "description": "Personal Access Token for Jira 9.17.3. Stored in macOS Keychain and sent only by the Tauri backend.",
              "validation": {
                "required": true,
                "minLength": 8
              },
              "requiresTauri": true
            },
            {
              "key": "config.jira.projectKeys",
              "storageKey": "config.jira.projectKeys",
              "label": "Jira Project Keys",
              "type": "string-list",
              "default": ["EVDEV"],
              "description": "Jira project keys. Enter one key per line.",
              "placeholder": "One project key per line",
              "validation": {
                "required": true,
                "itemPattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "itemLabel": "project key"
              },
              "aliases": ["config.jira.projectKey"]
            }
          ],
          "integration": true
        },
        {
          "id": "jenkins",
          "label": "Jenkins",
          "initiallyExpanded": true,
          "items": [
            {
              "key": "config.jenkins.url",
              "storageKey": "config.jenkins.url",
              "label": "Jenkins URL",
              "type": "string",
              "default": "",
              "description": "Dedicated Jenkins URL used by the Jenkins Query Runner.",
              "validation": {
                "required": true,
                "pattern": "^https?://"
              }
            },
            {
              "key": "config.jenkins.username",
              "storageKey": "config.jenkins.username",
              "label": "Jenkins Username",
              "type": "string",
              "default": "",
              "description": "Username paired with Jenkins API token.",
              "requiresTauri": true
            },
            {
              "key": "secure.jenkins.token",
              "storageKey": "secure.jenkins.token",
              "label": "Jenkins Token",
              "type": "secret",
              "default": "",
              "description": "Generate an API token from Jenkins (User \u279d Configure \u279d API Token). Token is stored securely in macOS Keychain, shown masked, and can only be replaced.",
              "validation": {
                "required": true,
                "minLength": 8
              },
              "requiresTauri": true
            }
          ],
          "integration": true
        }
      ]
    },
    {
      "id": "database",
      "label": "Database",
      "initiallyExpanded": true,
      "requiresTauri": true,
      "categories": [
        {
          "id": "oracle",
          "label": "Oracle",
          "requiresTauri": true,
          "initiallyExpanded": true,
          "items": [
            {
              "key": "config.oracle.connections",
              "storageKey": "config.oracle.connections",
              "label": "Database Connections",
              "type": "oracle-connections",
              "default": [],
              "description": "Manage Oracle database connections for Compare Config tool. Credentials are stored securely in macOS Keychain."
            }
          ]
        },
        {
          "id": "redis",
          "label": "Redis",
          "requiresTauri": true,
          "initiallyExpanded": true,
          "items": [
            {
              "key": "config.redis.host",
              "storageKey": "config.redis.host",
              "label": "Redis Host",
              "type": "string",
              "default": "",
              "description": "Hostname or IP address for the Redis cache.",
              "validation": {
                "required": true,
                "maxLength": 255,
                "pattern": "^[^\\s/@]+$"
              }
            },
            {
              "key": "config.redis.port",
              "storageKey": "config.redis.port",
              "label": "Redis Port",
              "type": "number",
              "default": 6379,
              "description": "Redis TCP port.",
              "validation": {
                "required": true,
                "min": 1,
                "max": 65535
              }
            },
            {
              "key": "config.redis.database",
              "storageKey": "config.redis.database",
              "label": "Redis Database",
              "type": "number",
              "default": 0,
              "description": "Logical Redis database number.",
              "validation": {
                "required": true,
                "min": 0,
                "max": 1024
              }
            },
            {
              "key": "config.redis.username",
              "storageKey": "config.redis.username",
              "label": "Redis Username",
              "type": "string",
              "default": "",
              "description": "Optional ACL username. Leave blank for password-only or unauthenticated Redis."
            },
            {
              "key": "config.redis.tls",
              "storageKey": "config.redis.tls",
              "label": "Use TLS",
              "type": "boolean",
              "default": false,
              "description": "Connect with rediss:// and verify the server certificate."
            },
            {
              "key": "secure.redis.password",
              "storageKey": "secure.redis.password",
              "label": "Redis Password",
              "type": "secret",
              "default": "",
              "description": "Optional Redis password. Stored securely in macOS Keychain and never exposed to the frontend. Save an empty value to clear it."
            }
          ]
        }
      ]
    },
    {
      "id": "kafka",
      "label": "Kafka Connections",
      "initiallyExpanded": false,
      "items": [
        {
          "key": "kafka.brokers",
          "storageKey": "tool:kafka:brokers",
          "label": "Plaintext Brokers",
          "type": "kafka-brokers",
          "description": "Save named broker connections for the Kafka tool. Connections use PLAINTEXT."
        }
      ]
    },
    {
      "id": "tool-settings",
      "label": "Tool Settings",
      "initiallyExpanded": true,
      "categories": [
        {
          "id": "lockey",
          "label": "Lockey",
          "initiallyExpanded": true,
          "items": [
            {
              "key": "config.lockeyPath",
              "storageKey": "config.lockeyPath",
              "label": "Lockey Path",
              "type": "string",
              "default": "",
              "description": "Path appended to the selected environment's CDN base URL, e.g. /localization/v1/language-pack?languagePackVersionUuid=\u2026",
              "validation": {
                "pattern": "^(?!.*(?:://|#))\\S*$"
              }
            }
          ]
        },
        {
          "id": "merge-sql",
          "label": "Merge SQL",
          "initiallyExpanded": true,
          "items": [
            {
              "key": "config.mergeSql.squadNames",
              "storageKey": "config.mergeSql.squadNames",
              "label": "Merge SQL Squad Names",
              "type": "string-list",
              "default": ["capella", "betelgeuse", "sirius", "bellatrix", "phoebe", "regulus", "canopus", "antares"],
              "description": "Known squad tokens used by Merge SQL relaxed filename parsing. Enter one squad name per line."
            }
          ]
        },
        {
          "id": "velocity-validator",
          "label": "Velocity API Validator",
          "initiallyExpanded": true,
          "items": [
            {
              "key": "config.velocityValidator.url",
              "storageKey": "config.velocityValidator.url",
              "label": "Validator API URL",
              "type": "string",
              "default": "",
              "description": "Full endpoint URL, e.g. http://sandbox.everest.supporting.devmandiri.co.id/api-migration/v1/velocity/template. Called only when you choose Validate. Desktop uses your machine's network and hosts mapping; web requires browser-compatible CORS and HTTP/HTTPS access.",
              "validation": {
                "pattern": "^(https?://[^\\s]+)?$"
              }
            },
            {
              "key": "config.velocityValidator.format",
              "storageKey": "config.velocityValidator.format",
              "label": "Request format",
              "type": "enum",
              "default": "json",
              "options": [
                {
                  "value": "json",
                  "label": "JSON"
                },
                {
                  "value": "form",
                  "label": "Form URL encoded"
                }
              ],
              "description": "JSON sends an object with context and template. Form sends context as JSON text and template as raw Velocity in separate encoded fields."
            }
          ]
        }
      ]
    }
  ]
}
