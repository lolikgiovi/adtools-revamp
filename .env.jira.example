# Copy this file to .env and replace the PAT locally. Never commit .env.
JIRA_BASE_URL=https://jira.corp.devmandiri.co.id
JIRA_PAT=replace-with-your-personal-access-token
JIRA_PROJECT_KEY=EVDEV

# Preferred: leave verification enabled and provide the corporate CA if needed.
JIRA_VERIFY_TLS=true
# JIRA_CA_BUNDLE=/absolute/path/to/mandiri-corporate-ca.pem

# Temporary fallback for the current self-signed certificate chain:
# JIRA_VERIFY_TLS=false

JIRA_ISSUE_TYPES=BE-Sub-Task,FE-Sub-Task
JIRA_SAMPLE_ISSUES=EVDEV-350443,EVDEV-344706,EVDEV-355352,EVDEV-350979,EVDEV-350851
